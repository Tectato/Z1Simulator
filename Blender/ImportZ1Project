        g_numSheets += 1
        startTime = time.process_time()
        print("\t> Importing " + file + "...")
        
        sheet = compile_svg(fullPath, file, collection)
        
        sheetLibrary[fullPath] = sheet
        #bpy.ops.object.shade_flat()
        
        material = None
        if "static" in dict:
            material = staticSheetMaterial
        else:
            material = sheetMaterial
        if sheet.data.materials:
             #assign to 1st material slot
            sheet.data.materials[0] = material
        else:
            # no slots
            sheet.data.materials.append(material)
        
        g_meshingTime = time.process_time() - startTime
    
    # Parse info
    #bpy.ops.transform.translate(value=(float(dict["pos_x"]) * scaleFactor, -float(dict["pos_z"]) * scaleFactor, float(dict["pos_y"]) * 0.003))
    # Account for different coordinate handedness!
    sheet.location = (float(dict["pos_x"]) * c_scaleFactor, -float(dict["pos_z"]) * c_scaleFactor, float(dict["pos_y"]) * c_sheetSpacing + c_sheetThickness/2.0)
    angleRaw = dict["rotation"]
    angle = 0.0
    if angleRaw.endswith("q"):
        angle = float(angleRaw.rstrip("q")) * math.pi/2.0
    else:
        angle = float(angleRaw)/360 * 2.0*math.pi
    #angle += math.pi
    
    #bpy.ops.transform.resize(value=(0.75,0.75,0.75)) # ?
    global c_sheetScalant
    #sheet.scale = c_sheetScaleVec
    #bpy.ops.transform.rotate(value=angle, orient_axis='Z')
    sheet.rotation_euler[2] = angle
    sheet.data.extrude = c_sheetThickness
    if "id" in dict:
        sheet.name = dict["id"]
    else:
        sheet.name = dict["file"] + "_" + str(dict["uuid"])
    
    sheet["uuid"] = int(dict["uuid"])
    global g_uuids
    g_uuids[str(sheet["uuid"])] = sheet
        
    return sheet

