    addRing(partA, machine, collection)
    addRing(partB, machine, collection)
    global eccentricArmPrefab
    arm = eccentricArmPrefab.copy()
    arm.data = eccentricArmPrefab.data
    arm.parent = partA
    collection.objects.link(arm)
    partA["eccArm"] = arm
    dist = (partA.matrix_world.translation.xy - partB.matrix_world.translation.xy).length
    #print("Pos A: (" + partA.name + ") " + str(partA.matrix_world.translation))
    #print("Pos B: (" + partB.name + ") " + str(partB.matrix_world.translation))
    #print("Dist: " + str(dist))
    arm.scale = mathutils.Vector((1,dist,1.0/partA.scale.z))
