def addImpulseRodRelation(partA, partB, machine, collection):
    global eccentricArmPrefab
    rod = eccentricArmPrefab.copy()
    rod.data = eccentricArmPrefab.data
    rod.parent = partA
    collection.objects.link(rod)
    diffVec = (partB.matrix_world.translation - partA.matrix_world.translation) * mathutils.Vector((1,1,0))
    global c_impulseRodOverhang
    dist = diffVec.xy.length + 2 * c_impulseRodOverhang
    angle = -mathutils.Vector((0,1)).angle_signed(diffVec.xy)
    #print("Pos A: (" + partA.name + ") " + str(partA.matrix_world.translation))
    #print("Pos B: (" + partB.name + ") " + str(partB.matrix_world.translation))
    #print("Dist: " + str(dist))
    rod.scale = mathutils.Vector((1,dist,1.0/partA.scale.z))
    rod.rotation_euler[2] = angle
    global c_eccentricThickness
    rod.location = -diffVec.normalized() * c_impulseRodOverhang + mathutils.Vector((0,0,c_eccentricThickness/partA.scale.z))
