def addRing(part, machine, collection):
    if "eccEnd" in part: return
    global eccentricEndPrefab
    ecc = eccentricEndPrefab.copy()
    ecc.data = eccentricEndPrefab.data
    ecc.parent = part
    collection.objects.link(ecc)
    ecc.scale = mathutils.Vector((1,1,1.0/part.scale.z))
    if "eccentric" in part:
        layer = machine["layers"][part["layer"]]
        ecc.location = mathutils.Vector((0,0,1)) * (layer.matrix_world.translation.z - part.matrix_world.translation.z)/part.scale.z
    part["eccEnd"] = ecc


def applyOverrides(project, dict):
    if "machines" in dict:
        for entryID in range(len(dict["machines"])):
            machineEntry = project["machines"][entryID]
            overrideEntry = {"uuid_override":-1}
            if str(machineEntry["uuid"]) in dict["machines"]:
                overrideEntry = dict["machines"][str(machineEntry["uuid"])]
            elif str(machineEntry["srcUUID"]) in dict["machines"]:
                overrideEntry = dict["machines"][str(machineEntry["srcUUID"])]
            else:
                print("No override entry for " + str(machineEntry["srcUUID"]) + " (currently " + str(machineEntry["uuid"]) + ")")
            machineEntry["uuid"] = overrideEntry["uuid_override"]
    elif "projects" in dict:
        for entryID in range(len(dict["projects"])):
            applyOverrides(project["projects"][entryID], dict["projects"][entryID])


# ImportHelper is a helper class, defines filename and
# invoke() function which calls the file selector.
from bpy_extras.io_utils import ImportHelper
from bpy.props import StringProperty, BoolProperty, EnumProperty
from bpy.types import Operator


class ImportZ1Project(Operator, ImportHelper):
    """This appears in the tooltip of the operator and in the generated docs"""
    bl_idname = "import_project.data"  # important since its how bpy.ops.import_test.some_data is constructed
    bl_label = "Import Project"

    # ImportHelper mix-in class uses this.
    filename_ext = ".json"

    filter_glob: StringProperty(
        default="*.json",
        options={'HIDDEN'},
        maxlen=255,  # Max internal buffer length, longer would be clamped.
    )

    def execute(self, context):
        return import_project(context, self.filepath)


# Only needed if you want to add into a dynamic menu.
def menu_func_import(self, context):
    self.layout.operator(ImportZ1Project.bl_idname, text="Z1 Project")


# Register and add to the "file selector" menu (required to use F3 search "Text Import Operator" for quick access).
def register():
    bpy.utils.register_class(ImportZ1Project)
    bpy.types.TOPBAR_MT_file_import.append(menu_func_import)


def unregister():
    bpy.utils.unregister_class(ImportZ1Project)
    bpy.types.TOPBAR_MT_file_import.remove(menu_func_import)


if __name__ == "__main__":
