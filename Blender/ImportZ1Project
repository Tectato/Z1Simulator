    file = dict["file"]
    sheet = None
    global g_meshingTime
    global sheetLibrary
    fullPath = str(basePath) + "\\" + file
    if fullPath in sheetLibrary:
        global g_instancingTimeSheets, g_numInstancesSheets
        startTime = time.process_time()
        #print("Sheet " + file + " exists, duplicating...")
