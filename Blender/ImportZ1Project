def read_data(parent, filepath):
    pathObj = Path(filepath)
    pathObj = pathObj.parent
    print("Importing: " + str(filepath))
    
    instanceCollection = bpy.data.collections.new(Path(filepath).stem)
    parent.children.link(instanceCollection)
    layer_instanceCollection = bpy.context.view_layer.active_layer_collection.children[instanceCollection.name]
    bpy.context.view_layer.active_layer_collection = layer_instanceCollection
    machineList = []
    projectList = []
    
    if bpy.context.active_object != None:
        bpy.context.active_object.select_set(False)
    f = open(filepath, "r", encoding="utf-8")
    data = f.read()
    f.close()
    
    dict = json.loads(data)
    
    #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.1, align='WORLD', location=(0, 0, 0), scale=(1, 1, 1))
    #projectRoot = bpy.context.active_object
    #projectRoot.name = instanceCollection.name
    projectRoot = bpy.data.objects.new(instanceCollection.name, None)
    projectRoot.empty_display_type = 'PLAIN_AXES'
    projectRoot.empty_display_size = 0.1

    instanceCollection.objects.link(projectRoot)
    instanceCollection["projectRoot"] = projectRoot
    
    global g_machines
    ### Deserialize project
    for machine in dict["machines"]:
        print("============")
        #print(machine)
        if "machine" in machine: # Direct machine definition
            newMachine = deserializeMachine(machine["machine"], pathObj, instanceCollection)
            if not "uuid" in newMachine:
                newMachine["uuid"] = int(machine["uuid"])
                newMachine["srcUUID"] = int(machine["uuid"])
                if not newMachine["uuid"] in g_machines:
                    g_machines[newMachine["uuid"]] = [newMachine]
                else:
                    g_machines[newMachine["uuid"]].append(newMachine)
            machineList.append(newMachine)
            newMachine.parent = projectRoot
        elif "path" in machine: # Path reference to different file
            relativePath = Path(machine["path"])
            project = read_data(instanceCollection, Path(pathObj,relativePath))
            projectList.append(project)
            for childObject in project.objects:
                if childObject.parent == None:
                    childObject.parent = projectRoot
            if "overrides" in machine:
                applyOverrides(project, machine["overrides"])
                #if "machines" in machine["overrides"]:
                #    for entryID in range(len(machine["overrides"]["machines"])):
                #        machineEntry = project["machines"][entryID]
                #        overrideEntry = machine["overrides"]["machines"][str(machineEntry["uuid"])]
                #        machineEntry["uuid"] = overrideEntry["uuid_override"]
            if "pos_x" in machine:
                offset = mathutils.Vector((float(machine["pos_x"])*c_scaleFactor, -float(machine["pos_z"])*c_scaleFactor, float(machine["pos_y"])*c_sheetSpacing))
                print("Offset: " + str(offset))
                #for machine in project["machines"]:
                #    print("Applying offset to " + machine.name)
                #    machine.location = machine.location + offset
                project["projectRoot"].location += offset
        bpy.context.view_layer.active_layer_collection = layer_instanceCollection
    
    if "relations" in dict:
        g_interMachineRelations.append([instanceCollection, projectRoot, dict["relations"]])
    
    instanceCollection["machines"] = machineList
    instanceCollection["projects"] = projectList
    return instanceCollection
    

def deserializeMachine(dict, basePath, collection):
    #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.1, align='WORLD', location=(0, 0, 0), scale=(1, 1, 1))
    machineRoot = bpy.data.objects.new(basePath.name, None)
    machineRoot.empty_display_type = 'PLAIN_AXES'
    machineRoot.empty_display_size = 0.1

    collection.objects.link(machineRoot)
    
    #machineRoot = bpy.context.active_object
    #machineRoot.name = basePath.name
    
    global g_highestSheetIndex
    layerIndex = 0
    layers = []
    for layer in dict["layers"]:
        layerInstance = deserializeLayer(layer, basePath, layerIndex, g_highestSheetIndex, collection)
        layerInstance.parent = machineRoot
        layerIndex += 1
        g_highestSheetIndex += 1
        layers.append(layerInstance)
    machineRoot["layers"] = layers
    
    globalPinHeight = g_highestSheetIndex * c_sheetSpacing
    globalPinScale = mathutils.Vector((1.0, 1.0, globalPinHeight * 100.0))
    global g_eccentrics
    pinsToResize = [] + g_eccentrics
    for pin in dict["globalPins"] + dict["clockPins"]:
        pinInstance = deserializePin(pin, collection)
        pinsToResize.append([pinInstance, pin])
    for pinInfo in pinsToResize:
        if "bounds" in pinInfo[1]:
            bmin = pinInfo[1]["bounds"][0]
            bmax = pinInfo[1]["bounds"][1]
            pinInfo[0].parent = layers[bmin]
            totalPinHeight = 0
            for i in range(max(bmin, 0), min(bmax+1, len(layers))):
                totalPinHeight += layers[i]["height"]
            pinInfo[0].scale = mathutils.Vector((1.0, 1.0, totalPinHeight * c_sheetSpacing * 100.0))
        else:
            pinInfo[0].parent = machineRoot
            pinInfo[0].scale = globalPinScale
    
    global g_uuids
    machineRoot["part_uuids"] = g_uuids
    if "uuid" in dict:
        machineRoot["srcUUID"] = dict["uuid"]
        machineRoot["uuid"] = dict["uuid"]
        if not machineRoot["uuid"] in g_machines:
            g_machines[newMachine["uuid"]] = [machineRoot]
        else:
            g_machines[newMachine["uuid"]].append(machineRoot)
    
    if "pos_x" in dict:
        machineRoot.location = (float(dict["pos_x"])*c_scaleFactor, -float(dict["pos_z"])*c_scaleFactor, float(dict["pos_y"])*c_sheetSpacing)
    
    
    if "relations" in dict:
        global g_relations
        g_relations[machineRoot] = [collection, dict["relations"]]
        

    g_uuids = {} # Clear global vars for next machine
    g_highestSheetIndex = 0
    g_eccentrics = []

    #print(dict)
    return machineRoot

def applyRelations():
    global g_relations
    for machineRoot in g_relations.keys():
        entry = g_relations[machineRoot]
        for relation in entry[1]:
            if relation["type"] == "arm" or relation["type"] == "rod":
                uuidA = str(relation["A"])
                uuidB = str(relation["B"])
                uuids = machineRoot["part_uuids"]
                if uuidA in uuids and uuidB in uuids:
                    if relation["type"] == "arm":
                        addEccentricRelation(uuids[uuidA], uuids[uuidB], machineRoot, entry[0])
                    else:
                        addImpulseRodRelation(uuids[uuidA], uuids[uuidB], machineRoot, entry[0])
    global g_interMachineRelations
    global g_machines
    for entry in g_interMachineRelations:
        collection = entry[0]
        projectRoot = entry[1]
        relations = entry[2]
        for relation in relations:
            if relation["type"] == "rod":
                try:
                    uuidA = str(relation["A"])
                    uuidB = str(relation["B"])
                    uuidsAParent = None
                    for candidate in g_machines[relation["AParent"]]:
                        if candidate["uuid"] == relation["AParent"]:
                            uuidsAParent = candidate["part_uuids"]
                            break
                    uuidsBParent = None
                    for candidate in g_machines[relation["BParent"]]:
                        if candidate["uuid"] == relation["BParent"]:
                            uuidsBParent = candidate["part_uuids"]
                            break
                    if uuidsAParent and uuidsBParent:
                        addImpulseRodRelation(uuidsAParent[uuidA], uuidsBParent[uuidB], projectRoot, entry[0])
                except:
                    print("Inter-machine relation failed to apply")

def deserializeLayer(dict, basePath, index, startHeight, collection):
    #bpy.ops.object.empty_add(type='PLAIN_AXES', radius=0.1, align='WORLD', location=(0, 0, startHeight * c_sheetSpacing), scale=(1, 1, 1))
    #layerRoot = bpy.context.active_object
    layerRoot = bpy.data.objects.new("Layer", None)
    layerRoot.empty_display_type = 'PLAIN_AXES'
    layerRoot.empty_display_size = 0.1
    layerRoot.location = mathutils.Vector((0, 0, startHeight * c_sheetSpacing))

    collection.objects.link(layerRoot)
    
    if "id" in dict:
        layerRoot.name = dict["id"]
    else:
        layerRoot.name = "Layer " + str(index)
    print("- " + layerRoot.name)
    
    localHighestSheetIndex = 0
    global g_highestSheetIndex
    sheets = []
    for sheet in dict["sheets"]:
        sheetInstance = deserializeSheet(sheet, basePath, collection)
        sheetInstance.parent = layerRoot
        g_highestSheetIndex = max(g_highestSheetIndex, startHeight + int(sheet["pos_y"]))
        localHighestSheetIndex = max(localHighestSheetIndex, int(sheet["pos_y"]))
        sheets.append(sheetInstance)
    #sheetInstance = deserializeSheet(dict["sheets"][0], basePath)
    #sheetInstance.parent = layerRoot
    
    if "arms" in dict or dict["pins"]:
        localHighestSheetIndex = max(3, localHighestSheetIndex)
        g_highestSheetIndex = max(g_highestSheetIndex, startHeight + localHighestSheetIndex)
    
    localPinHeight = (localHighestSheetIndex+1) * c_sheetSpacing
    pins = []
    for pin in dict["pins"]:
        pinInstance = deserializePin(pin, collection)
        pinInstance.parent = layerRoot
        pinInstance.scale = mathutils.Vector((1.0, 1.0, localPinHeight * 100.0))
        pins.append(pinInstance)
    
    if "arms" in dict:
        global g_eccentrics
        eccentrics = []
        for eccentric in dict["arms"]:
            eccentricInstance = deserializePin(eccentric, collection, True)
            eccentricInstance.parent = layerRoot
            eccentricInstance["layer"] = index
            eccentrics.append(eccentricInstance)
            g_eccentrics.append([eccentricInstance, eccentric])
        layerRoot["eccentrics"] = eccentrics
    
    layerRoot["height"] = (localHighestSheetIndex+1)
    layerRoot["sheets"] = sheets
    layerRoot["pins"] = pins
    
    return layerRoot

def deserializePin(dict, collection, eccentric = False):
    global g_instancingTimePins, g_numInstancesPins
    startTime = time.process_time()
    if bpy.context.active_object != None:
        bpy.context.active_object.select_set(False)
    pin = None
    if eccentric or "static" in dict:
        global pinPrefabStatic
        pin = pinPrefabStatic.copy()
        pin.data = pinPrefabStatic.data
        #pinPrefabStatic.select_set(True)
        #bpy.context.view_layer.objects.active = pinPrefabStatic
    else:
        global pinPrefabLogic
        pin = pinPrefabLogic.copy()
        pin.data = pinPrefabLogic.data
        #pinPrefabLogic.select_set(True)
        #bpy.context.view_layer.objects.active = pinPrefabLogic
    collection.objects.link(pin)
    #bpy.ops.object.duplicate(linked=True)
    #pin = bpy.context.active_object
    pin.location = (float(dict["pos_x"])*c_scaleFactor, -float(dict["pos_z"])*c_scaleFactor, 0)
    
    if "id" in dict:
        pin.name = dict["id"]
    else:
        pin.name = ("pin_" if not eccentric else "eccentric_") + str(dict["uuid"])
    
    if eccentric:
        pin["eccentric"] = None
    
    pin["uuid"] = int(dict["uuid"])
    global g_uuids
    g_uuids[str(pin["uuid"])] = pin

    g_numInstancesPins += 1
    g_instancingTimePins += time.process_time() - startTime
    return pin


### SVG Parser written mostly by AI because I can't be bothered

# Slop Start
# ---------- SVG path parsing ----------

TOKEN_RE = re.compile(
    r"[A-Za-z]|[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?"
)

def path_subpaths(d):
    """Yield subpaths as lists of cubic segments: (p0, c1, c2, p1)."""
    tokens = TOKEN_RE.findall(d)
    i = 0
    command = None
    current = (0.0, 0.0)
    start = None
    segments = []

    def number():
        nonlocal i
        if i >= len(tokens) or tokens[i].isalpha():
            raise ValueError("Unexpected end of SVG path data")
        value = float(tokens[i])
        i += 1
        return value

    def finish():
        nonlocal segments
        if segments:
            yield_segments = segments
            segments = []
            return yield_segments
        return None

    while i < len(tokens):
        if tokens[i].isalpha():
            command = tokens[i]
            i += 1
        elif command is None:
            raise ValueError("Path data must start with a command")

        if command == "Z":
            if segments and segments[-1][3] != start:
                p0 = segments[-1][3]
                p1 = start
                segments.append((p0, p0, p1, p1))
            done = finish()
            if done:
                yield done
            current = start
            command = None
            continue

        if command == "M":
            x, y = number(), number()
            done = finish()
            if done:
                yield done
            current = start = (x, y)
            # Further coordinate pairs after M are implicit L commands.
            command = "L"
            continue

        if command == "L":
            x, y = number(), number()
            p0, p1 = current, (x, y)
            segments.append((p0, p0, p1, p1))
            current = p1
            continue

        if command == "H":
            x = number()
            p0, p1 = current, (x, current[1])
            segments.append((p0, p0, p1, p1))
            current = p1
            continue

        if command == "V":
            y = number()
            p0, p1 = current, (current[0], y)
            segments.append((p0, p0, p1, p1))
            current = p1
            continue

        if command == "A":
            rx, ry, rotation, large_arc, sweep, x, y = (
                number(), number(), number(), number(), number(), number(), number()
            )
            p0, p1 = current, (x, y)

            #if not math.isclose(rx, ry, rel_tol=1e-6, abs_tol=1e-6):
            #    raise ValueError("Only circular SVG arcs (rx == ry) are supported")
            #if not math.isclose(rotation % 360.0, 0.0, abs_tol=1e-6):
            #    raise ValueError("Rotated SVG arcs are not supported")
            #if large_arc != 0:
            #    raise ValueError("Only 90-degree SVG arcs are supported")

            # For a quarter-circle, the cubic handle length is r * 4/3*tan(22.5°).
            # Find the center from the two endpoints and sweep direction.
            dx, dy = p1[0] - p0[0], p1[1] - p0[1]
            chord = math.hypot(dx, dy)
            r = rx
            #if r <= 0 or not math.isclose(chord, r * math.sqrt(2),
            #                               rel_tol=1e-5, abs_tol=1e-5):
            #    raise ValueError("Arc is not a 90-degree circular arc")

            mid = ((p0[0] + p1[0]) / 2, (p0[1] + p1[1]) / 2)
            h = math.sqrt(max(0.0, r*r - chord*chord/4))
            # Unit perpendicular to the chord; sweep selects which center.
            perp = (-dy / chord, dx / chord)
            sign = -1 if not sweep else 1
            center = (mid[0] + sign*h*perp[0], mid[1] + sign*h*perp[1])

            a0 = math.atan2(p0[1] - center[1], p0[0] - center[0])
            a1 = math.atan2(p1[1] - center[1], p1[0] - center[0])
            delta = (a1 - a0) % (2 * math.pi) if sweep else -((a0 - a1) % (2 * math.pi))
            #if not math.isclose(abs(delta), math.pi / 2, abs_tol=1e-5):
            #    raise ValueError("Arc sweep is not 90 degrees")

            k = 4.0 / 3.0 * math.tan(abs(delta) / 4.0)
            sign_delta = 1.0 if delta > 0 else -1.0
            c1 = (
                p0[0] - sign_delta*k*(p0[1] - center[1]),
                p0[1] + sign_delta*k*(p0[0] - center[0]),
            )
            c2 = (
                p1[0] + sign_delta*k*(p1[1] - center[1]),
                p1[1] - sign_delta*k*(p1[0] - center[0]),
            )
            segments.append((p0, c1, c2, p1))
            current = p1
            continue

        raise ValueError(f"Unsupported SVG path command: {command}")

    done = finish()
    if done:
        yield done


# ---------- Curve creation ----------

def add_spline(curve, segments):
    if not segments:
        return None

    # A connected chain of cubic segments has one more point than segments.
    points = [segments[0][0]] + [seg[3] for seg in segments]
    spline = curve.splines.new("BEZIER")
    spline.bezier_points.add(len(points) - 1)
    spline.use_cyclic_u = True

    def blender_point(p):
        x, y = p
        return (x, -y, 0.0)

    for i, bp in enumerate(spline.bezier_points):
        bp.co = blender_point(points[i])
        bp.handle_left_type = "FREE"
        bp.handle_right_type = "FREE"

        # Default handles make straight segments.
        bp.handle_left = bp.co
        bp.handle_right = bp.co

    for i, (p0, c1, c2, p1) in enumerate(segments):
        spline.bezier_points[i].handle_right = blender_point(c1)
        spline.bezier_points[i + 1].handle_left = blender_point(c2)

    # Ensure straight segments remain straight rather than being smoothed.
    for i, (p0, c1, c2, p1) in enumerate(segments):
        if c1 == p0:
            spline.bezier_points[i].handle_right_type = "VECTOR"
        if c2 == p1:
            spline.bezier_points[i + 1].handle_left_type = "VECTOR"
    return spline


def compile_svg(filepath, object_name, collection):
    root = ET.parse(filepath).getroot()
    curve = bpy.data.curves.new(object_name, "CURVE")
    curve.dimensions = "2D"
    curve.resolution_u = 2
    curve.fill_mode = "BOTH"
    
    outline = None

    def visit(element):
        tag = element.tag.rsplit("}", 1)[-1]

        if tag == "path":
            d = element.get("d", "")
            for subpath in path_subpaths(d):
                spline = add_spline(curve, subpath)
                if element.get("id") == "outlinePath":
                    nonlocal outline
                    outline = spline
                    spline.use_smooth = False
                else:
                    type = element.get("id").split("_")[0]
                    if not (type == "pointHole" or type == "longHole"):
                        spline.use_smooth = False

        elif tag == "circle":
            cx = float(element.get("cx", 0))
            cy = float(element.get("cy", 0))
            r = float(element.get("r", 0))
            if r <= 0:
                return
            k = 4.0 / 3.0 * math.tan(math.pi / 8.0)
            p = [
                (cx + r, cy), (cx, cy + r),
                (cx - r, cy), (cx, cy - r),
            ]
            segs = []
            for i in range(4):
                p0, p1 = p[i], p[(i + 1) % 4]
                c1 = (p0[0] - (p0[1]-cy)*k, p0[1] + (p0[0]-cx)*k)
                c2 = (p1[0] + (p1[1]-cy)*k, p1[1] - (p1[0]-cx)*k)
                segs.append((p0, c1, c2, p1))
            add_spline(curve, segs)

        elif tag == "rect":
            x = float(element.get("x", 0))
            y = float(element.get("y", 0))
            w = float(element.get("width", 0))
            h = float(element.get("height", 0))
            if w <= 0 or h <= 0:
                return
            corners = [(x, y), (x+w, y), (x+w, y+h), (x, y+h)]
            segs = []
            for i, p0 in enumerate(corners):
                p1 = corners[(i + 1) % 4]
                segs.append((p0, p0, p1, p1))
            spline = add_spline(curve, segs)
            spline.use_smooth = False

        # Recurse into groups and the document root. Other elements are ignored.
        for child in element:
            visit(child)

    visit(root)
    
    # Calculate and apply offset plus scale
    vMin = outline.bezier_points[0].co #mathutils.Vector((1.0, 1.0, 1.0)) * 1000000
    vMax = outline.bezier_points[0].co #mathutils.Vector((1.0, 1.0, 1.0)) * -1000000
    midPoint = mathutils.Vector((0.0, 0.0, 0.0))
    for point in outline.bezier_points:
        vMin = mathutils.Vector((
            min(vMin.x,point.co.x),
            min(vMin.y,point.co.y),
            min(vMin.z,point.co.z)
            ))
        vMax = mathutils.Vector((
            max(vMax.x,point.co.x),
            max(vMax.y,point.co.y),
            max(vMax.z,point.co.z)
            ))
    midPoint = (vMax+vMin)/2
    
    for spline in curve.splines:
        for point in spline.bezier_points:
            point.co = (point.co - midPoint) * 0.0002
            point.handle_left = (point.handle_left - midPoint) * 0.0002
            point.handle_right = (point.handle_right - midPoint) * 0.0002

    obj = bpy.data.objects.new(object_name, curve)
    collection.objects.link(obj)
    return obj

