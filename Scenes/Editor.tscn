custom_minimum_size = Vector2(100, 24)
layout_mode = 2
bbcode_enabled = true
text = "Shows groups of [color=00FFFF]output pins[/color] as values in decimal and binary. Both representations can be edited and the other and corresponding [color=00FFFF]pins[/color] will reflect the change.
To create an entry, select the desired [color=00FFFF]output pins[/color] in the 3D scene from least significant bit to highest while holding shift, then press the [b]+[/b] button."
fit_content = true
autowrap_mode = 2

